# Tunnel email config — copy values into .env.local (gitignored)
# Gmail: use an App Password (myaccount.google.com/apppasswords), NOT your real password.

MAIL_USER=you@gmail.com
MAIL_APP_PASSWORD=your-16-char-app-password
MAIL_TO=you@example.com

# Optional overrides
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_FROM=you@gmail.com
# MAIL_TIMEOUT_MS=20000
# MAIL_ALLOW_INSECURE_TLS=0

# Tunnel behavior
# TUNNEL_PORT=4000
# TUNNEL_HEALTH_PATH=/health
# TUNNEL_HEALTH_INTERVAL_MS=5000
# TUNNEL_HEALTH_MAX_FAILURES=3
# TUNNEL_HEALTH=0   # set to 0 to disable the local-server health monitor
